    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "react-scripts": "^5.0.1",
    "typescript": "^4.9.5",
    "webpack-bundle-analyzer": "^5.2.0"
