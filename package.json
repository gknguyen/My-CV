{
  "name": "my-cv",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "craco start",
    "build": "craco build",
    "build:analyze": "BUILD_ANALYZE=true craco build",
    "eject": "craco eject",
    "format": "prettier --write ./src/**/*.{ts,tsx}",
