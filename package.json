{
  "name": "my-cv",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "craco -r @cypress/instrument-cra start",
    "build": "craco build",
    "build:analyze": "BUILD_ANALYZE=true craco build",
    "eject": "craco eject",
    "test": "cypress run --component",
    "test:w": "cypress open --component --browser chrome",
    "test:cov": "npm test && nyc report --reporter=text --reporter html",
    "test:e2e": "cypress run --e2e",
    "test:w:e2e": "cypress open --e2e --browser chrome",
    "test:e2e:cov": "npm run test:e2e && nyc report --reporter=text --reporter html --report-dir coverage-e2e",
    "format": "prettier --write ./src/**/*.{ts,tsx}",
    "lint": "eslint ./src --ext .js,.jsx,.ts,.tsx",
    "prepare": "husky"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@headlessui/react": "^2.0.3",
    "@heroicons/react": "^2.1.3",
    "@material-tailwind/react": "^2.1.9",
    "@mui/icons-material": "^5.15.3",
    "@mui/material": "^5.15.3",
    "dayjs": "^1.11.10",
    "framer-motion": "^11.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-draggable": "^4.4.6",
    "react-router-dom": "^6.21.1",
    "tailwindcss": "^3.4.3",
    "tss-react": "^4.9.3",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@craco/craco": "^7.1.0",
    "@cypress/code-coverage": "^3.14.7",
    "@cypress/instrument-cra": "^1.4.0",
    "@testing-library/cypress": "^10.1.0",
    "@types/node": "^22.19.7",
    "@types/react": "^18.2.47",
    "@types/react-dom": "^18.2.18",
    "@types/webpack-bundle-analyzer": "^4.7.0",
    "cypress": "^13.17.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "react-scripts": "^5.0.1",
    "typescript": "^4.9.5",
    "webpack-bundle-analyzer": "^5.2.0"
  },
  "overrides": {
    "nth-check": "^2.0.1",
    "underscore": "^1.13.7"
  }
}
