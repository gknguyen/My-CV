{
  "compilerOptions": {
    "composite": true,
    "outDir": "./node_modules/.tmp/tsconfig.node",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client"]
  },
  "include": ["vite.config.ts", "plugins/**/*.ts", "src/data/*.ts", "src/shared/helper.tsx"]
}
